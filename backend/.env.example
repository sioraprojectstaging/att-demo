# Siora One backend configuration.
# Local: copy to backend/.env.  Vercel: set in the siora-one-api project's
# Environment Variables (DATABASE_URL and BLOB_READ_WRITE_TOKEN are added
# automatically when Neon and Blob are connected to the project).

# --- Core -------------------------------------------------------------------
# Required when DEBUG is off. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Defaults to True locally and False on Vercel.
DEBUG=True
# Extra hostnames, comma separated (localhost and *.vercel.app are built in).
ALLOWED_HOSTS=

# --- Web app / CORS -----------------------------------------------------------
# Public URL of the web app; allowed for CORS and CSRF automatically.
FRONTEND_URL=http://localhost:5173
# Extra browser origins, comma separated. Native mobile apps don't need CORS.
CORS_ALLOWED_ORIGINS=
# Regexes, e.g. ^https://siora-one-[a-z0-9-]+\.vercel\.app$ for preview deployments
CORS_ALLOWED_ORIGIN_REGEXES=

# --- Database -----------------------------------------------------------------
# Either a full URL (Neon on Vercel)...
DATABASE_URL=
# ...or individual values for a local Postgres.
DB_NAME=attendance_db_local
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- File uploads ---------------------------------------------------------------
# Vercel Blob read-write token. When set, uploads go to Blob; otherwise to backend/media/.
BLOB_READ_WRITE_TOKEN=

# --- Face recognition -------------------------------------------------------------
# Folder containing models/buffalo_l/*.onnx (default: ~/.insightface locally, /tmp/insightface on Vercel).
FACE_MODEL_ROOT=
# Base URL serving det_10g.onnx and w600k_r50.onnx. Required on Vercel.
FACE_MODEL_BASE_URL=

# --- Auth ---------------------------------------------------------------------------
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=30
TIME_ZONE=Asia/Kolkata

# Used by `python manage.py create_superadmin`
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
